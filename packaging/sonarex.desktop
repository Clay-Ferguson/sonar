# Template only. packaging/build-deb.sh rewrites Exec= and Icon= for where it is
# installing to, so the paths below are never used.
[Desktop Entry]
Name=Sonar
Comment=Search file contents recursively under a folder
Exec=/path/to/sonar/start.sh
Icon=sonarex
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=sonarex
